        INTEGER quantity "NOT NULL"
        NUMERIC(10,2) unit_price "NOT NULL"
    }
    orders {
        INTEGER id PK "NOT NULL"
        INTEGER user_id FK "NOT NULL"
        VARCHAR(32) status "NOT NULL"
        NUMERIC(12,2) total_amount "NOT NULL"
        TIMESTAMP created_at "NOT NULL"
    }
    products {
        INTEGER id PK "NOT NULL"
        INTEGER category_id FK "NOT NULL"
        VARCHAR(64) sku UK "NOT NULL"
        VARCHAR(255) name "NOT NULL"
        NUMERIC(10,2) price "NOT NULL"
        JSON metadata
    }
    raw_events {
        VARCHAR(64) event_type "NOT NULL"
        TEXT payload "NOT NULL"
        TIMESTAMP occurred_at "NOT NULL"
    }
    tenant_members {
        INTEGER tenant_id PK "NOT NULL"
        INTEGER user_id PK,FK "NOT NULL"
        VARCHAR(32) role "NOT NULL"
    }
    users {
        INTEGER id PK "NOT NULL"
        VARCHAR(255) email UK "NOT NULL"
        VARCHAR(64) username UK "NOT NULL"
        BOOLEAN is_active "NOT NULL"
        TIMESTAMP created_at "NOT NULL"
    }
