        NUMERIC(12,2) total_amount
    }
    categories {
        INTEGER id PK "NOT NULL"
        INTEGER parent_id FK
        VARCHAR(128) slug UK "NOT NULL"
        VARCHAR(128) name "NOT NULL"
    }
    member_audits {
        INTEGER id PK "NOT NULL"
        INTEGER tenant_id FK "NOT NULL"
