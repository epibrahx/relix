erDiagram
    %% 多租户主账号表（含复合主键与带引号大小写混合标识符），用于隔离不同企业的订单与财务数据。
    TenantAccount {
        INTEGER TenantID PK "NOT NULL; 租户唯一标识，与 AccountCode 共同构成复合主键"
        VARCHAR(64) AccountCode PK "NOT NULL"
        TEXT display_name "NOT NULL; 对外展示的企业全称（支持长中文备注自动换行测试，确保右侧面板与画布悬停浮层不截断、不溢出视口边界）"
        TEXT contact_email UK
        TIMESTAMP created_at "NOT NULL"
    }
    %% 无主键审计日志追加表（验证无主键表在画布、Inspector 与导出中的稳定渲染）
    audit_events {
        TIMESTAMP occurred_at "NOT NULL"
        TEXT actor "NOT NULL"
        TEXT action "NOT NULL"
        JSONB payload "变更前后的结构化 JSON 快照，不含任何业务敏感凭据"
    }
    %% Materialized View: billing.mv_monthly_revenue
    %% 月度营收汇总物化视图（界面需明确标记为 MVIEW）
    mv_monthly_revenue {
        INTEGER tenant_id
        VARCHAR(64) account_code
        TEXT gross_revenue
    }
    %% 财务销售订单主表（范围分区父表），通过复合外键关联多租户主账号。
    sales_orders {
        BIGINT order_id PK "NOT NULL"
        INTEGER tenant_id FK "NOT NULL"
        VARCHAR(64) account_code FK "NOT NULL"
        order_status status "NOT NULL; 订单履约状态（自定义枚举类型 order_status）"
        cn_currency_amount total_amount "NOT NULL; 订单应付总金额，使用自定义域类型 cn_currency_amount 确保非负"
        TEXT remark
        TIMESTAMP created_at "NOT NULL"
    }
    %% 2026 年度订单子分区表
    sales_orders_2026 {
        BIGINT order_id PK "NOT NULL"
        INTEGER tenant_id "NOT NULL"
        VARCHAR(64) account_code "NOT NULL"
        order_status status "NOT NULL"
        cn_currency_amount total_amount "NOT NULL"
        TIMESTAMP created_at "NOT NULL"
    }
    %% View: billing.v_active_orders
    %% 活跃销售订单逻辑视图（界面需明确标记为 VIEW）
    v_active_orders {
        BIGINT order_id
        INTEGER tenant_id
        VARCHAR(64) account_code
        order_status status
        cn_currency_amount total_amount
    }
    TenantAccount ||--o{ sales_orders : "tenant_id, account_code [declared]"
